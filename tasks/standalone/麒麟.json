{
    "task": [
        {
            "name": "自动麒麟",
            "label": "麒麟",
            "entry": "麒麟-开始时间检查",
            "group": ["standalone"],
            "option": [
                "麒麟是否切换御魂",
                "麒麟阵容预设",
                "麒麟是否切换出战阵容"
            ]
        }
    ],
    "option": {
        "麒麟是否切换御魂": {
            "type": "switch",
            "label": "是否切换御魂",
            "default_case": "Yes",
            "cases": [
                {"name": "Yes", "label": "是", "pipeline_override": {
                    "麒麟-选择换御魂": {"enabled": true},
                    "麒麟-选择不换御魂": {"enabled": false}
                }},
                {"name": "No", "label": "否", "pipeline_override": {
                    "麒麟-选择换御魂": {"enabled": false},
                    "麒麟-选择不换御魂": {"enabled": true}
                }}
            ]
        },
        "麒麟阵容预设": {
            "type": "input",
            "label": "麒麟阵容预设",
            "description": "切换御魂时使用的分组和队伍名称",
            "inputs": [
                {
                    "name": "group_name",
                    "label": "分组预设名称",
                    "description": "填写分组预设名称",
                    "default": "默认分组",
                    "pipeline_type": "string"
                },
                {
                    "name": "team_name",
                    "label": "队伍预设名称",
                    "description": "填写队伍预设名称",
                    "default": "默认队伍",
                    "pipeline_type": "string"
                }
            ],
            "pipeline_override": {
                "麒麟6": {
                    "custom_action_param": {
                        "group_name": "{group_name}",
                        "team_name": "{team_name}"
                    }
                }
            }
        },
        "麒麟是否切换出战阵容": {
            "type": "switch",
            "label": "是否在备战页切换出战阵容",
            "default_case": "No",
            "cases": [
                {"name": "Yes", "label": "是", "pipeline_override": {
                    "麒麟-需要出战预设": {"enabled": true},
                    "麒麟-不用出战预设": {"enabled": false},
                    "麒麟-直接开战": {"enabled": false}
                }, "option": ["麒麟出战阵容预设"]},
                {"name": "No", "label": "否", "pipeline_override": {
                    "麒麟-需要出战预设": {"enabled": false},
                    "麒麟-不用出战预设": {"enabled": true},
                    "麒麟-直接开战": {"enabled": true}
                }}
            ]
        },
        "麒麟出战阵容预设": {
            "type": "input",
            "label": "备战页出战阵容预设",
            "inputs": [
                {"name": "battle_group_name", "label": "出战分组名称", "default": "默认分组", "pipeline_type": "string"},
                {"name": "battle_team_name", "label": "出战队伍名称", "default": "默认队伍", "pipeline_type": "string"}
            ],
            "pipeline_override": {
                "麒麟-切换出战阵容": {
                    "custom_action_param": {
                        "position": "麒麟",
                        "group_name": "{battle_group_name}",
                        "team_name": "{battle_team_name}"
                    }
                }
            }
        }
    }
}
