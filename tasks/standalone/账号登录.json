{
    "task": [
        {
            "name": "账号登录",
            "label": "账号登录",
            "entry": "账号登录",
            "option": [
                "账号登录配置"
            ],
            "group": ["standalone"],
            "controller": [
                "Android"
            ]
        }
    ],
    "option": {
        "账号登录配置": {
            "type": "input",
            "label": "账号登录配置",
            "description": "选择已保存的邮箱账号、平台和目标区服。需要密码重新登录时请使用控制面。",
            "inputs": [
                {
                    "name": "email",
                    "label": "邮箱账号",
                    "description": "目标网易邮箱（如 user@163.com）",
                    "default": "",
                    "pipeline_type": "string"
                },
                {
                    "name": "platform",
                    "label": "登录平台（android / ios）",
                    "description": "填写 android 或 ios",
                    "default": "android",
                    "pipeline_type": "string"
                },
                {
                    "name": "server",
                    "label": "区服名称",
                    "description": "目标区服名称（如 全平台互通、携手同心）",
                    "default": "",
                    "pipeline_type": "string"
                }
            ],
            "pipeline_override": {
                "账号登录": {
                    "custom_action_param": {
                        "email": "{email}",
                        "platform": "{platform}",
                        "server": "{server}"
                    }
                }
            }
        }
    }
}
