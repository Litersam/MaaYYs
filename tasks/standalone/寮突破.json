{
    "task": [
        {
            "name": "自动寮突破",
            "label": "寮突破",
            "entry": "寮突",
            "group": ["standalone"],
            "option": [
                "寮突破挑战限额",
                "寮突-是否切换御魂阵容"
            ]
        }
    ],
    "option": {
        "寮突破挑战限额": {
            "type": "input",
            "label": "寮突破挑战限额",
            "description": "按寮突破界面自身的剩余挑战次数停止，不使用个人突破券或退四策略。次数上限为 0 则跳过；尚未进攻且挑战次数已用完则等待恢复。",
            "inputs": [
                {"name": "limit_count", "label": "进攻次数上限（0 不进攻）", "default": "50", "pipeline_type": "int"}
            ],
            "pipeline_override": {
                "寮突-策略": {"custom_action_param": {"mode": "guild", "limit_count": "{limit_count}"}}
            }
        },
        "寮突-是否切换御魂阵容": {
            "type": "switch",
            "label": "是否切换御魂阵容",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "是",
                    "pipeline_override": {
                        "寮突-开始装备御魂": {
                            "enabled": true
                        }
                    },
                    "option": ["寮突阵容预设"]
                },
                {
                    "name": "No",
                    "label": "否",
                    "pipeline_override": {
                        "寮突-开始装备御魂": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "寮突阵容预设": {
            "type": "input",
            "label": "寮突阵容预设",
            "description": "填写阴阳寮突破需要使用的分组和队伍预设名称",
            "inputs": [
                {
                    "name": "group_name",
                    "label": "分组预设名称",
                    "description": "填写分组预设名称",
                    "default": "默认分组",
                    "pipeline_type": "string"
                },
                {
                    "name": "team_name",
                    "label": "队伍预设名称",
                    "description": "填写队伍预设名称",
                    "default": "默认队伍",
                    "pipeline_type": "string"
                }
            ],
            "pipeline_override": {
                "寮突19": {
                    "custom_action_param": {
                        "group_name": "{group_name}",
                        "team_name": "{team_name}"
                    }
                }
            }
        }
    }
}
