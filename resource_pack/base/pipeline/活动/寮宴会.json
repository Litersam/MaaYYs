            {"recognition": "OCR", "roi": [1055, 91, 220, 37], "expected": "(^|[:： ])\\s*10\\s*[/／]\\s*10$"},
            {"recognition": "OCR", "roi": [1055, 138, 220, 38], "expected": "(^|[:： ])\\s*10\\s*[/／]\\s*10$"},
            {"recognition": "OCR", "roi": [1055, 185, 220, 38], "expected": "(^|[:： ])\\s*10\\s*[/／]\\s*10$"}
