    "寮宴会-结束证据": {
        "recognition": "Or",
        "any_of": [
            {"recognition": "OCR", "roi": [240, 85, 800, 380], "expected": ["^(本次)?(阴阳寮|寮)?宴会(已)?结束[！!。]?$", "^宴会经验(已达|已达到)上限[！!。]?$", "^本次宴会获得的经验已达上限[！!。]?$"]},
